# Copy this file to ".env" (next to migrate_queue.py) and fill in the values. ".env" is in .gitignore - never commit it.
# Variables already set in the environment win over this file.

# Path to the service-account key file (.json)
GOOGLE_APPLICATION_CREDENTIALS=sa-key.json

# Target spreadsheet ID: the part of the URL between /d/ and /edit
PMIS_SPREADSHEET_ID=

# Gemini API key (only needed for a real run, not for --dry-run / --check-access / --extract)
GEMINI_API_KEY=

# Optional: model name (default is DEFAULT_MODEL in migrate_queue.py; --model wins over this)
# GEMINI_MODEL=

# Only for --extract: exact tab names of the legacy sheets (brackets and spaces included)
# PMIS_LEGACY_DWR_SHEET=
# PMIS_LEGACY_DRQ_SHEET=
